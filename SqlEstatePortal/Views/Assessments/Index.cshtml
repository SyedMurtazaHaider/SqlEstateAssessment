@model IEnumerable<SqlEstatePortal.Models.AssessmentRun>
@{
    ViewData["Title"] = "Assessments";
    var canRun = await Permissions.HasAsync(User, AppModules.Assessments, "insert");
}
<div class="page-toolbar">
    <h1>Assessments</h1>
    <div class="toolbar-actions">
        @if (canRun)
        {
            <form asp-action="CheckServerStatus" method="post" class="js-check-server-status"
                  data-progress-title="Checking server status"
                  data-progress-msg="Pinging servers and updating Reachable / UnReachable…"
                  data-fallback="@Url.Action("Index")">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary">Check Server Status</button>
            </form>
            <form asp-action="Run" method="post" class="js-run-assessment"
                  data-progress-title="Running assessment"
                  data-progress-msg="Collecting data from Reachable servers…"
                  data-fallback="@Url.Action("Index")">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">
                    Run Assessment
                </button>
            </form>
        }
    </div>
</div>
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
<div class="panel">
    <p class="muted">Runs <code>Assess-SqlEstate.ps1</code>, imports JSON findings into SQL Server, and keeps full history.</p>
    <table class="table table-hover align-middle">
        <thead>
        @await Html.PartialAsync("_ColumnFilters", new[] { "Run #", "Started", "Status", "By", "Servers", "Critical", "High", "Medium", "Low", "" })
        </thead>
        <tbody>
        @foreach (var run in Model)
        {
            <tr>
                <td>@run.Id</td>
                <td>@run.StartedAt.ToLocalTime().ToString("g")</td>
                <td><span class="badge @(run.Status == "Succeeded" ? "bg-success" : run.Status == "Failed" ? "bg-danger" : "bg-warning text-dark")">@run.Status</span></td>
                <td>@run.TriggeredBy</td>
                <td>@run.ReachableCount / @run.ServerCount</td>
                <td>@run.CriticalCount</td>
                <td>@run.HighCount</td>
                <td>@run.MediumCount</td>
                <td>@run.LowCount</td>
                <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@run.Id">Open</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
