@model SqlEstatePortal.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var canRun = await Permissions.HasAsync(User, AppModules.Assessments, "insert");
    var canOpenAssessments = await Permissions.HasAsync(User, AppModules.Assessments, "view");
    var selected = Model.SelectedRun;
}
<div class="page-toolbar">
    <div>
        <h1>Dashboard</h1>
        @if (selected != null)
        {
            <p class="estate-line">
                Run #@selected.Id · @selected.StartedAt.ToLocalTime().ToString("g")
                @if (!string.IsNullOrWhiteSpace(Model.SelectedServer))
                {
                    <text> · @Model.SelectedServer</text>
                }
                else
                {
                    <text> · All servers</text>
                }
                · @Model.FindingCount findings
            </p>
        }
        else
        {
            <p class="estate-line">No assessment imported yet</p>
        }
    </div>
    <div class="toolbar-actions">
        @if (canOpenAssessments && selected != null)
        {
            <a class="btn btn-outline-secondary" asp-controller="Assessments" asp-action="Details" asp-route-id="@selected.Id">Open report</a>
        }
        @if (canRun)
        {
            <form asp-controller="Assessments" asp-action="CheckServerStatus" method="post" class="js-check-server-status"
                  data-progress-title="Checking server status"
                  data-progress-msg="Pinging servers and updating Reachable / UnReachable…"
                  data-fallback="@Url.Action("Index", "Dashboard")">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary">Check Server Status</button>
            </form>
            <form asp-controller="Assessments" asp-action="Run" method="post" class="js-run-assessment"
                  data-progress-title="Running assessment"
                  data-progress-msg="Collecting data from Reachable servers…"
                  data-fallback="@Url.Action("Index", "Assessments")">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">Run assessment</button>
            </form>
        }
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (Model.AvailableRuns.Count > 0)
{
    <form method="get" asp-controller="Dashboard" asp-action="Index" class="filter-bar dashboard-filters" id="dashboardFilters">
        <label for="runId">Assessment date</label>
        <select id="runId" name="runId" class="form-select assessment-filter">
            @foreach (var run in Model.AvailableRuns)
            {
                if (run.Id == Model.SelectedRunId)
                {
                    <option value="@run.Id" selected>@run.StartedAt.ToLocalTime().ToString("g") · #@run.Id · @run.Status</option>
                }
                else
                {
                    <option value="@run.Id">@run.StartedAt.ToLocalTime().ToString("g") · #@run.Id · @run.Status</option>
                }
            }
        </select>
        <label for="server">Server</label>
        <select id="server" name="server" class="form-select server-filter">
            @if (string.IsNullOrWhiteSpace(Model.SelectedServer))
            {
                <option value="" selected>All servers</option>
            }
            else
            {
                <option value="">All servers</option>
            }
            @foreach (var name in Model.ServerNames)
            {
                if (string.Equals(name, Model.SelectedServer, StringComparison.OrdinalIgnoreCase))
                {
                    <option value="@name" selected>@name</option>
                }
                else
                {
                    <option value="@name">@name</option>
                }
            }
        </select>
        <button type="submit" class="btn btn-primary filter-go-btn">Go</button>
    </form>
}

<div class="kpi-grid" id="dashboardRoot" data-report-url="@(selected != null ? Url.Action("Details", "Assessments", new { id = selected.Id }) : null)" data-server="@(Model.SelectedServer ?? "")">
    <div class="kpi-card accent-blue">
        <div class="label">Servers</div>
        <div class="value">@Model.ServerCount</div>
    </div>
    <div class="kpi-card accent-green">
        <div class="label">Reachable</div>
        <div class="value">@Model.ReachableCount</div>
    </div>
    @if (canOpenAssessments && selected != null)
    {
        <a class="kpi-card accent-red kpi-link" href="@Url.Action("Details", "Assessments", new { id = selected.Id, tab = "findings", severity = "Critical", server = Model.SelectedServer })">
            <div class="label">Critical</div>
            <div class="value">@Model.CriticalCount</div>
        </a>
        <a class="kpi-card accent-amber kpi-link" href="@Url.Action("Details", "Assessments", new { id = selected.Id, tab = "findings", severity = "High", server = Model.SelectedServer })">
            <div class="label">High</div>
            <div class="value">@Model.HighCount</div>
        </a>
        <a class="kpi-card accent-teal kpi-link" href="@Url.Action("Details", "Assessments", new { id = selected.Id, tab = "databases", server = Model.SelectedServer })">
            <div class="label">Databases</div>
            <div class="value">@Model.DatabaseCount</div>
        </a>
    }
    else
    {
        <div class="kpi-card accent-red">
            <div class="label">Critical</div>
            <div class="value">@Model.CriticalCount</div>
        </div>
        <div class="kpi-card accent-amber">
            <div class="label">High</div>
            <div class="value">@Model.HighCount</div>
        </div>
        <div class="kpi-card accent-teal">
            <div class="label">Databases</div>
            <div class="value">@Model.DatabaseCount</div>
        </div>
    }
    <div class="kpi-card accent-navy">
        <div class="label">Allocated GB</div>
        <div class="value">@Model.AllocatedStorageGb.ToString("N0")</div>
    </div>
</div>

@if (selected == null)
{
    <div class="panel"><p class="muted mb-0">Run an assessment or keep a JSON report in the reports folder to populate these charts.</p></div>
}
else
{
    <div class="chart-grid">
        <section class="chart-panel">
            <h2>Findings by severity</h2>
            <p>Distribution for the selected date@(string.IsNullOrWhiteSpace(Model.SelectedServer) ? "" : " and server")</p>
            <div class="chart-frame"><canvas id="chartSeverity"></canvas></div>
        </section>
        <section class="chart-panel">
            <h2>Support status</h2>
            <p>Instance support lifecycle</p>
            <div class="chart-frame"><canvas id="chartSupport"></canvas></div>
        </section>
        <section class="chart-panel">
            <h2>Recovery models</h2>
            <p>Databases by recovery model</p>
            <div class="chart-frame"><canvas id="chartRecovery"></canvas></div>
        </section>
        <section class="chart-panel wide">
            <h2>Findings by area</h2>
            <p>Top assessment areas · hover a bar or label for what each area means</p>
            <div class="chart-frame tall"><canvas id="chartArea"></canvas></div>
            <ul class="chart-area-guide" aria-label="Finding area definitions">
                <li><strong title="Backup and DBCC CHECKDB service levels — missing or overdue full/log backups and integrity checks.">SLA</strong></li>
                <li><strong title="Instance and database best-practice settings (configuration standards).">Standards</strong></li>
                <li><strong title="Cost and efficiency opportunities (for example backup compression defaults).">Cost</strong></li>
                <li><strong title="Security posture — privileged access, surface area, and risky settings.">Security</strong></li>
                <li><strong title="Performance health — memory, waits, and related runtime risks.">Performance</strong></li>
                <li><strong title="Edition, core count, and licensing alignment risks.">Licensing</strong></li>
                <li><strong title="Microsoft support lifecycle — versions near or past end of support.">Supportability</strong></li>
            </ul>
        </section>
        <section class="chart-panel">
            <h2>Findings by server</h2>
            <p>Where issues concentrate</p>
            <div class="chart-frame"><canvas id="chartServer"></canvas></div>
        </section>
        <section class="chart-panel wide">
            <h2>Finding trend</h2>
            <p>Severity counts across recent runs</p>
            <div class="chart-frame tall"><canvas id="chartHistory"></canvas></div>
        </section>
        <section class="chart-panel">
            <h2>Largest databases</h2>
            <p>Top 12 by data size (MB)</p>
            <div class="chart-frame tall"><canvas id="chartDatabases"></canvas></div>
        </section>
        <section class="chart-panel">
            <h2>Volume free space</h2>
            <p>Lowest free % first</p>
            <div class="chart-frame tall"><canvas id="chartVolumes"></canvas></div>
        </section>
        <section class="chart-panel">
            <h2>Top waits</h2>
            <p>Wait time (ms)</p>
            <div class="chart-frame tall"><canvas id="chartWaits"></canvas></div>
        </section>
        <section class="chart-panel">
            <h2>SQL Agent jobs</h2>
            <p>Last run status</p>
            <div class="chart-frame"><canvas id="chartJobs"></canvas></div>
        </section>
        <section class="chart-panel">
            <h2>Services</h2>
            <p>Windows service state</p>
            <div class="chart-frame"><canvas id="chartServices"></canvas></div>
        </section>
        <section class="chart-panel">
            <h2>Editions</h2>
            <p>SQL Server editions in the estate</p>
            <div class="chart-frame"><canvas id="chartEditions"></canvas></div>
        </section>
    </div>
}

@if (Model.RecentRuns.Count > 0)
{
    <div class="panel">
        <h2 class="section-title">Run history</h2>
        <table class="table table-sm mb-0">
            <thead>
                @await Html.PartialAsync("_ColumnFilters", new[] { "#", "When", "Status", "Findings", "" })
            </thead>
            <tbody>
            @foreach (var r in Model.RecentRuns)
            {
                <tr>
                    <td>@r.Id</td>
                    <td>@r.StartedAt.ToLocalTime().ToString("g")</td>
                    <td>@r.Status</td>
                    <td>C @r.CriticalCount / H @r.HighCount / M @r.MediumCount / L @r.LowCount</td>
                    <td>
                        @if (canOpenAssessments)
                        {
                            <a asp-controller="Assessments" asp-action="Details" asp-route-id="@r.Id">Open</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<script type="application/json" id="dashboard-charts">@Html.Raw(Model.ChartsJson)</script>
@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/dashboard-charts.js" asp-append-version="true"></script>
}
