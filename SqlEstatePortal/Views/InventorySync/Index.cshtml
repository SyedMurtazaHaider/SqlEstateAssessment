@model IEnumerable<SqlEstatePortal.Models.InventorySyncBatch>
@{
    ViewData["Title"] = "Sync History";
    string? status = ViewBag.Status as string;
}
<div class="page-toolbar">
    <h1>Database Sync History</h1>
    <a class="btn btn-outline-secondary" asp-controller="Assessments" asp-action="Index">Assessments</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="panel">
    <form method="get" class="filter-bar mb-3">
        <label for="status">Status</label>
        <select id="status" name="status" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
            <option value="">All</option>
            @foreach (var s in new[] { "PendingApproval", "Applied", "Rejected" })
            {
                if (string.Equals(status, s, StringComparison.OrdinalIgnoreCase))
                {
                    <option value="@s" selected>@s</option>
                }
                else
                {
                    <option value="@s">@s</option>
                }
            }
        </select>
    </form>

    <table class="table table-hover align-middle">
        <thead>
        <tr>
            <th>Batch #</th>
            <th>Assessment</th>
            <th>Status</th>
            <th>New</th>
            <th>Changed</th>
            <th>Removed</th>
            <th>Created</th>
            <th>By</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.Id</td>
                <td>#@b.AssessmentRunId</td>
                <td><span class="badge @(b.Status == "Applied" ? "bg-success" : b.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark")">@b.Status</span></td>
                <td>@b.NewCount</td>
                <td>@b.ChangedCount</td>
                <td>@b.RemovedCount</td>
                <td>@b.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                <td>@b.CreatedBy</td>
                <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Review" asp-route-id="@b.Id">Open</a></td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <p class="muted mb-0">No sync batches yet. Open Assessments and click <strong>Sync to register</strong> on a succeeded run.</p>
    }
</div>
