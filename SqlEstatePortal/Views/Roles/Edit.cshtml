@model SqlEstatePortal.ViewModels.RoleFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Add Role" : "Edit Role";
    var action = Model.Id == 0 ? "Create" : "Edit";
}
<div class="page-toolbar">
    <h1>@(Model.Id == 0 ? "Create Role" : "Edit Role")</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
</div>
<div class="panel">
    <form asp-action="@action" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Description"></label>
                <input asp-for="Description" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="IsActive"></label>
                <select asp-for="IsActive" class="form-select">
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </select>
            </div>
        </div>
        <h2 class="section-title">Module permissions</h2>
        <p class="muted">Assign View, Insert, Update, and Delete for each module.</p>
        <table class="table table-bordered permission-table">
            <thead>
            @await Html.PartialAsync("_ColumnFilters", new[] { "Module", "-View", "-Insert", "-Update", "-Delete" })
            </thead>
            <tbody>
            @for (var i = 0; i < Model.Permissions.Count; i++)
            {
                <tr>
                    <td>
                        <input type="hidden" asp-for="Permissions[i].Module" />
                        @Model.Permissions[i].Module
                    </td>
                    <td class="text-center"><input asp-for="Permissions[i].CanView" class="form-check-input" /></td>
                    <td class="text-center"><input asp-for="Permissions[i].CanInsert" class="form-check-input" /></td>
                    <td class="text-center"><input asp-for="Permissions[i].CanUpdate" class="form-check-input" /></td>
                    <td class="text-center"><input asp-for="Permissions[i].CanDelete" class="form-check-input" /></td>
                </tr>
            }
            </tbody>
        </table>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">SAVE ROLE</button>
            <a class="btn btn-secondary" asp-action="Index">CANCEL</a>
        </div>
    </form>
</div>
