@model IEnumerable<SqlEstatePortal.Models.AccessRole>
@{
    ViewData["Title"] = "Roles";
    var canInsert = await Permissions.HasAsync(User, AppModules.Roles, "insert");
    var canUpdate = await Permissions.HasAsync(User, AppModules.Roles, "update");
    var canDelete = await Permissions.HasAsync(User, AppModules.Roles, "delete");
}
<div class="page-toolbar">
    <h1>Roles & Permissions</h1>
    @if (canInsert)
    {
        <a class="btn btn-primary" asp-action="Create">Add role</a>
    }
</div>
<div class="panel">
    <table class="table table-hover align-middle">
        <thead>
        @await Html.PartialAsync("_ColumnFilters", canUpdate || canDelete
            ? new[] { "Role", "Description", "Active", "Modules with access", "" }
            : new[] { "Role", "Description", "Active", "Modules with access" })
        </thead>
        <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Name</td>
                <td>@role.Description</td>
                <td>@(role.IsActive ? "Yes" : "No")</td>
                <td>@string.Join(", ", role.Permissions.Where(p => p.CanView || p.CanInsert || p.CanUpdate || p.CanDelete).Select(p => p.Module))</td>
                @if (canUpdate || canDelete)
                {
                    <td class="text-end">
                        @if (canUpdate)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@role.Id">Edit</a>
                        }
                        @if (canDelete)
                        {
                            <form asp-action="Delete" asp-route-id="@role.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this role?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        }
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
</div>
