@{
    var canDashboard = User.Identity?.IsAuthenticated == true && await Permissions.HasAsync(User, AppModules.Dashboard, "view");
    var canAssessments = User.Identity?.IsAuthenticated == true && await Permissions.HasAsync(User, AppModules.Assessments, "view");
    var canApplications = User.Identity?.IsAuthenticated == true && await Permissions.HasAsync(User, AppModules.Applications, "view");
    var canDatabases = User.Identity?.IsAuthenticated == true && await Permissions.HasAsync(User, AppModules.Databases, "view");
    var canInventoryServers = User.Identity?.IsAuthenticated == true && await Permissions.HasAsync(User, AppModules.InventoryServers, "view");
    var canCosts = User.Identity?.IsAuthenticated == true && await Permissions.HasAsync(User, AppModules.Costs, "view");
    var canTeam = User.Identity?.IsAuthenticated == true && await Permissions.HasAsync(User, AppModules.TeamMembers, "view");
    var canRoles = User.Identity?.IsAuthenticated == true && await Permissions.HasAsync(User, AppModules.Roles, "view");
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string NavClass(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Charles Taylor SQL Estate Management</title>
    <link rel="icon" type="image/png" href="~/img/logo.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/img/logo.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-shell">
<aside class="sidebar">
    <div class="sidebar-brand">
        <div class="sidebar-brand-top">
            <img src="~/img/logo.png" alt="Charles Taylor" class="brand-logo sidebar-logo" asp-append-version="true" />
            <button type="button" class="sidebar-menu-btn" id="sidebarMenuBtn" aria-label="Collapse menu" title="Collapse menu">
                <span></span><span></span><span></span>
            </button>
        </div>
        <span class="sidebar-brand-text">SQL Estate Management</span>
    </div>
    <nav class="sidebar-nav">
        <div class="nav-group-label"><span>Main</span></div>
        @if (canDashboard)
        {
            <a class="nav-item @NavClass("Dashboard")" asp-controller="Dashboard" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13h7V4H4v9zm0 7h7v-5H4v5zm9 0h7V11h-7v9zm0-16v5h7V4h-7z"/></svg>
                <span class="nav-label">Dashboard</span>
            </a>
        }
        @if (canAssessments)
        {
            <a class="nav-item @NavClass("Assessments")" asp-controller="Assessments" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14H6v-2h6v2zm4-4H6v-2h10v2zm0-4H6V7h10v2z"/></svg>
                <span class="nav-label">Assessments</span>
            </a>
        }
        @if (canAssessments || canDatabases)
        {
            <a class="nav-item @NavClass("InventorySync")" asp-controller="InventorySync" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/></svg>
                <span class="nav-label">Sync History</span>
            </a>
        }
        @if (canApplications)
        {
            <a class="nav-item @NavClass("Applications")" asp-controller="Applications" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h10v2H4v-2zM18.5 15.5 16 18l-1.5-1.5L13 18l3.5 3.5L21 17l-2.5-1.5z"/></svg>
                <span class="nav-label">Application Register</span>
            </a>
        }
        @if (canDatabases)
        {
            <a class="nav-item @NavClass("Databases")" asp-controller="Databases" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3C7.58 3 4 4.79 4 7v10c0 2.21 3.58 4 8 4s8-1.79 8-4V7c0-2.21-3.58-4-8-4zm0 2c3.87 0 6 1.43 6 2s-2.13 2-6 2-6-1.43-6-2 2.13-2 6-2zm0 14c-3.87 0-6-1.43-6-2v-1.39c1.55.9 3.7 1.39 6 1.39s4.45-.49 6-1.39V17c0 .57-2.13 2-6 2zm0-5c-3.87 0-6-1.43-6-2v-1.39c1.55.9 3.7 1.39 6 1.39s4.45-.49 6-1.39V12c0 .57-2.13 2-6 2z"/></svg>
                <span class="nav-label">Database Register</span>
            </a>
        }
        @if (canInventoryServers)
        {
            <a class="nav-item @NavClass("InventoryServers")" asp-controller="InventoryServers" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 1h16c.55 0 1 .45 1 1v4c0 .55-.45 1-1 1H4c-.55 0-1-.45-1-1V2c0-.55.45-1 1-1zm0 8h16c.55 0 1 .45 1 1v4c0 .55-.45 1-1 1H4c-.55 0-1-.45-1-1v-4c0-.55.45-1 1-1zm0 8h16c.55 0 1 .45 1 1v4c0 .55-.45 1-1 1H4c-.55 0-1-.45-1-1v-4c0-.55.45-1 1-1zM9 4h2v1H9V4zm0 8h2v1H9v-1zm0 8h2v1H9v-1z"/></svg>
                <span class="nav-label">Servers</span>
            </a>
        }
        @if (canCosts)
        {
            <a class="nav-item @NavClass("Costs")" asp-controller="Costs" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg>
                <span class="nav-label">Cost Register</span>
            </a>
        }
        @if (canTeam || canRoles)
        {
            <div class="nav-group-label"><span>Admin tools</span></div>
        }
        @if (canTeam)
        {
            <a class="nav-item @NavClass("TeamMembers")" asp-controller="TeamMembers" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                <span class="nav-label">Team Members</span>
            </a>
        }
        @if (canRoles)
        {
            <a class="nav-item @NavClass("Roles")" asp-controller="Roles" asp-action="Index">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
                <span class="nav-label">Roles</span>
            </a>
        }
    </nav>
    <button type="button" class="sidebar-hide-btn" id="sidebarHideBtn" title="Collapse menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
        <span class="sidebar-hide-label">Collapse menu</span>
    </button>
</aside>
<div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>
<div class="workspace">
    <header class="topbar">
        <button type="button" class="menu-toggle" id="sidebarToggle" aria-label="Collapse menu" title="Collapse menu">
            <span></span><span></span><span></span>
        </button>
        <img src="~/img/logo.png" alt="Charles Taylor" class="brand-logo topbar-logo" asp-append-version="true" />
        <div class="crumb">SQL Estate Management · @ViewData["Title"]</div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            @await Component.InvokeAsync("OpsHeaderMeta")
            <div class="user-chip">
                <strong>@User.FindFirst("MemberName")?.Value</strong>
                <span class="muted">@User.FindFirst("AccessRoleName")?.Value</span>
                <a asp-controller="Account" asp-action="ChangePassword">Change password</a>
                <a asp-controller="Account" asp-action="Logout">Logout</a>
            </div>
        }
    </header>
    <main class="app-main">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>
</div>
<div id="assessmentProgressOverlay" class="assessment-progress-overlay" hidden aria-live="polite" aria-busy="false">
    <div class="assessment-progress-card">
        <h2 id="assessmentProgressTitle">Running assessment</h2>
        <p class="muted assessment-progress-msg" id="assessmentProgressMsg">Collecting data from Reachable servers…</p>
        <div class="assessment-progress-track" role="progressbar" aria-valuemin="1" aria-valuemax="100" aria-valuenow="1">
            <div class="assessment-progress-bar" id="assessmentProgressBar" style="width: 1%;"></div>
        </div>
        <div class="assessment-progress-pct" id="assessmentProgressPct">1%</div>
        <div class="assessment-progress-timer" id="assessmentProgressTimer">
            <span id="assessmentStartTime">Started: --:--:--</span>
            <span class="assessment-timer-sep">·</span>
            <span id="assessmentElapsedTime">Elapsed: 00:00</span>
        </div>
    </div>
</div>

<div class="modal fade" id="runAssessmentModal" tabindex="-1" aria-labelledby="runAssessmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content linked-db-modal">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title" id="runAssessmentModalLabel">Run assessment</h2>
                    <p class="linked-db-modal-sub muted mb-0">Choose Reachable servers to include. All are selected by default.</p>
                </div>
                <div class="linked-db-modal-meta">
                    <span class="linked-db-count-badge" id="runAssessmentCount">0 selected</span>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body">
                <div class="run-assess-toolbar">
                    <input type="search" id="runAssessmentSearch" class="form-control form-control-sm" placeholder="Filter servers…" autocomplete="off" />
                    <div class="run-assess-toolbar-actions">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="runAssessmentSelectAll">Select all</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="runAssessmentClearAll">Clear all</button>
                    </div>
                </div>
                <div id="runAssessmentEmpty" class="muted" hidden>No Reachable servers. Run Check Server Status first.</div>
                <div class="run-assess-list" id="runAssessmentList"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="runAssessmentConfirm">Run on selected</button>
            </div>
        </div>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
